<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="LocalMind.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalMind"
    xmlns:views="using:LocalMind.Views"
    xmlns:vm="using:LocalMind.ViewModels"
    xmlns:icons="using:FluentIcons.WinUI"
    xmlns:winuiex="using:WinUIEx"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LocalMind">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="LocalMind"
                        LeftClickCommand="{x:Bind ShowFromTrayCommand}">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="LM" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Click="TrayOpen_Click" />
                    <MenuFlyoutItem Text="New Chat" Command="{Binding NewChatCommand}" />
                    <MenuFlyoutItem Text="Exit" Click="TrayExit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Title bar with search -->
        <Grid Grid.Row="0" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="LocalMind" />

            <!-- Empty drag region behind the search box -->
            <Border x:Name="AppTitleBar" Grid.Column="1" Background="Transparent" />

            <AutoSuggestBox Grid.Column="1"
                            Width="360"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            PlaceholderText="Search chats and messages..."
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <AutoSuggestBox.QueryIcon>
                    <icons:SymbolIcon Symbol="Search" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Padding="16" RowSpacing="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.Resources>
                    <Style x:Key="ChatItemContainerStyle" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                    <DataTemplate x:Key="ChatItemTemplate" x:DataType="vm:ChatViewModel">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Title}" />
                            <Button Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Pin / Unpin"
                                    Click="PinChat_Click">
                                <icons:SymbolIcon FontSize="16" Symbol="Pin" />
                            </Button>
                            <Button Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Delete chat"
                                    Click="DeleteChat_Click">
                                <icons:SymbolIcon FontSize="16" Symbol="Delete" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NewChatCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <icons:SymbolIcon Symbol="Add" />
                        <TextBlock Text="New Chat" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1"
                            Spacing="4"
                            Visibility="{Binding HasPinned, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="4,4,0,0"
                               Text="Pinned"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="PinnedList"
                              ItemsSource="{Binding PinnedChats}"
                              SelectedItem="{Binding SelectedChat, Mode=OneWay}"
                              SelectionChanged="ChatList_SelectionChanged"
                              SelectionMode="Single"
                              MaxHeight="220"
                              ItemContainerStyle="{StaticResource ChatItemContainerStyle}"
                              ItemTemplate="{StaticResource ChatItemTemplate}" />
                </StackPanel>

                <Grid Grid.Row="2" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="4,4,0,0"
                               Text="Chats"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="ChatList"
                              Grid.Row="1"
                              ItemsSource="{Binding Chats}"
                              SelectedItem="{Binding SelectedChat, Mode=OneWay}"
                              SelectionChanged="ChatList_SelectionChanged"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource ChatItemContainerStyle}"
                              ItemTemplate="{StaticResource ChatItemTemplate}" />
                </Grid>

                <StackPanel Grid.Row="3" Spacing="8">
                    <InfoBar Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisibility}}"
                             IsOpen="{Binding UpdateReady}"
                             IsClosable="False"
                             Severity="Success"
                             Title="Update ready">
                        <InfoBar.ActionButton>
                            <Button Command="{Binding RestartForUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:SymbolIcon Symbol="ArrowClockwise" />
                                    <TextBlock Text="Restart" />
                                </StackPanel>
                            </Button>
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Button HorizontalAlignment="Stretch" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <icons:SymbolIcon Symbol="Settings" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Column="1">
                <views:ChatView DataContext="{Binding SelectedChat}"
                                Visibility="{Binding DataContext.IsSettingsOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsOpen, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</winuiex:WindowEx>
