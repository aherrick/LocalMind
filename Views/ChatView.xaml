<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LocalMind.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalMind"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:icons="using:FluentIcons.WinUI"
    xmlns:vm="using:LocalMind.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header bar: model selector / context indicator -->
        <Border Grid.Row="0"
                Padding="16,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          MinWidth="240"
                          PlaceholderText="Select a model"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding ReadyModels}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          IsEnabled="{Binding IsModelSelectionEnabled}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{Binding ContextDisplay}" />
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Style="{StaticResource ResponsiveContentHostStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Messages -->
                <ScrollViewer Grid.Row="0"
                              x:Name="MessagesScroll"
                              Padding="16"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Messages}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageVM">
                                <Grid Margin="0,0,0,16">
                                    <Border Padding="12,8"
                                            HorizontalAlignment="{x:Bind Alignment}"
                                            Background="{x:Bind Background}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Header}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ProgressRing IsActive="True"
                                                          Width="20"
                                                          Height="20"
                                                          HorizontalAlignment="Left"
                                                          Visibility="{x:Bind IsThinking, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <controls:MarkdownTextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                                        IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind TimeDisplay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Padding="6,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Copy"
                                                        Visibility="{x:Bind CopyVisibility, Mode=OneWay}"
                                                        Click="CopyMessage_Click">
                                                    <icons:SymbolIcon FontSize="14" Symbol="Copy" />
                                                </Button>
                                                <Button Padding="6,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Regenerate response"
                                                        Visibility="{x:Bind RegenerateVisibility, Mode=OneWay}"
                                                        Click="Regenerate_Click">
                                                    <icons:SymbolIcon FontSize="14" Symbol="ArrowClockwise" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input -->
                <Grid Grid.Row="1" Padding="16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="InputBox"
                             PlaceholderText="Ask anything..."
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MaxHeight="160"
                             Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Width="48"
                            ToolTipService.ToolTip="Send message"
                            Command="{Binding SendCommand}"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <icons:SymbolIcon Symbol="Send" />
                    </Button>

                    <Button Grid.Column="1"
                            Width="48"
                            ToolTipService.ToolTip="Stop generating"
                            Command="{Binding StopCommand}"
                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}">
                        <icons:SymbolIcon Symbol="Stop" />
                    </Button>
                </Grid>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
