<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LocalMind.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalMind"
    xmlns:vm="using:LocalMind.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: model selector / context indicator -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      MinWidth="240"
                      PlaceholderText="Select a model"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding ReadyModels}"
                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                      Visibility="{Binding IsModelLocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding ModelDisplay}"
                       Visibility="{Binding IsModelLocked, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{Binding ContextDisplay}" />
        </Grid>

        <!-- Messages -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChatMessageVM">
                        <Grid Margin="0,0,0,16">
                            <Border MaxWidth="640"
                                    Padding="12,8"
                                    HorizontalAlignment="{x:Bind Alignment}"
                                    Background="{x:Bind Background}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Header}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                               IsTextSelectionEnabled="True"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="InputBox"
                     PlaceholderText="Ask anything..."
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     MaxHeight="160"
                     Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="1"
                    Content="➤"
                    MinWidth="48"
                    Command="{Binding SendCommand}"
                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

            <Button Grid.Column="1"
                    Content="■"
                    MinWidth="48"
                    Command="{Binding StopCommand}"
                    Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
