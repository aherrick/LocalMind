<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LocalMind.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.WinUI"
    xmlns:vm="using:LocalMind.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SettingCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource ResponsiveContentHostStyle}">
        <ScrollViewer Padding="16"
                      HorizontalContentAlignment="Stretch"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid HorizontalAlignment="Stretch"
                ColumnSpacing="20"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="Settings"
                           Style="{ThemeResource TitleTextBlockStyle}" />

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                    <TextBlock Text="Models" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Foundry Local" />
                                <ItemsControl ItemsSource="{Binding FoundryModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FoundryModelVM">
                                            <Grid Margin="0,4" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                                                <Button Grid.Column="1"
                                                        MinWidth="96"
                                                        Content="{x:Bind Status, Mode=OneWay}"
                                                        Visibility="{x:Bind IsReady, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                        Command="{x:Bind DownloadCommand}" />
                                                <Button Grid.Column="2"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Delete model"
                                                        Visibility="{x:Bind CanDelete, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                                        Click="DeleteModel_Click">
                                                    <icons:SymbolIcon FontSize="16" Symbol="Delete" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ollama" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding OllamaStatus}"
                                               Style="{StaticResource SettingCaption}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding OllamaModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Margin="0,2"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="General" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Theme" />
                                        <TextBlock Text="Applies immediately." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              MinWidth="140"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding ThemeOptions}"
                                              SelectedItem="{Binding Theme, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Start minimized to tray" />
                                        <TextBlock Text="Launch without showing the window." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{Binding StartMinimized, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Close button minimizes to tray" />
                                        <TextBlock Text="Turn off to exit LocalMind when you close the window." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Run at startup" />
                                        <TextBlock Text="Start LocalMind when you sign in to Windows." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  IsOn="{Binding RunAtStartup, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Logs" />
                                        <TextBlock Text="Open the diagnostics folder." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            MinWidth="96"
                                            Command="{Binding OpenLogsCommand}"
                                            Content="Open" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Updates" />
                                        <TextBlock Text="Check for a newer version." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            MinWidth="96"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Content="Check" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Version" />
                                        <TextBlock Text="Installed application version." Style="{StaticResource SettingCaption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding AppVersion}"
                                               Style="{StaticResource SettingCaption}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Chat" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="System prompt" />
                                <TextBlock Text="Sent at the start of every chat." Style="{StaticResource SettingCaption}" />
                                <TextBox AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="96"
                                         PlaceholderText="e.g. You are a concise assistant. Answer in plain language."
                                         Text="{Binding SystemPrompt, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </ContentControl>
</UserControl>
